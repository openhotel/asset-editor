{
  "tasks": {
    "start": "deno run -A --watch=./src --unstable-kv mod.ts",
    "start:nowatch": "deno run -A --unstable-kv mod.ts",

    "compile": "deno compile -A --unstable-kv --no-check",

    "compile:windows": "deno task compile --target=x86_64-pc-windows-msvc --output ./build/asset_editor_windows ./mod.ts",
    "compile:linux": "deno task compile --target=x86_64-unknown-linux-gnu --output ./build/asset_editor_linux ./mod.ts",
    "compile:darwin": "deno task compile --target=x86_64-apple-darwin --output ./build/asset_editor_darwin ./mod.ts",

    "build": "(deno task compile:linux) & (deno task compile:darwin) & (deno task compile:windows)"
  },
  "imports": {
    "shared/": "./src/shared/",
    "system/": "./src/system/",
    "modules/": "./src/modules/",

    "@oh/utils": "jsr:@oh/utils@1.5.0",

    "@zip-js": "jsr:@zip-js/zip-js@2.7.53",
    "@std/yaml": "jsr:@std/yaml@1.0.5",

    "deno/": "https://deno.land/std@0.221.0/",
    "loadenv": "https://deno.land/x/loadenv@v1.0.1/mod.ts",

    "yaml": "npm:yaml@2.4.2",
    "open": "https://deno.land/x/open@v0.0.6/index.ts",
    "imagescript": "https://deno.land/x/imagescript@1.3.0/mod.ts"
  }
}
